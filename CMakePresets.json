{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "WINUX11 Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "sourceDir": "${sourceDir}/shell",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "WINUX11 Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "sourceDir": "${sourceDir}/shell",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ]
}