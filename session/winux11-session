#!/bin/sh
set -eu
export XDG_CURRENT_DESKTOP=WINUX11
export XDG_SESSION_DESKTOP=WINUX11
export XDG_CURRENT_SESSION_TYPE=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export WAYLAND_DISPLAY=winux11-0
WINUX11Compositor &
COMPOSITOR_PID=$!
cleanup(){ kill "$COMPOSITOR_PID" 2>/dev/null || true; }
trap cleanup EXIT INT TERM
for i in $(seq 1 50); do
  if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/winux11-0" ]; then break; fi
  sleep 0.1
done
WINUX11Shell &
SHELL_PID=$!
wait "$SHELL_PID"